---
/**
 * Interruptor de tema claro / oscuro.
 *
 * El estado inicial lo decide el script del <head> de Base.astro, que corre
 * antes de pintar para que no haya destello blanco. Aquí sólo se cambia.
 *
 * Guardamos la elección en localStorage. Mientras el visitante no toque el
 * interruptor, el sitio sigue la preferencia de su sistema operativo — incluso
 * si la cambia con la página abierta.
 */
import Icono from './Icono.astro';
---

<button
  id="alternar-tema"
  type="button"
  class="grid size-10 place-items-center rounded-xl border border-borde bg-superficie
         text-apagado hover:bg-realce hover:text-tinta cursor-pointer"
  aria-label="Cambiar entre modo claro y oscuro"
  aria-pressed="false"
>
  <Icono nombre="moon-line" clase="size-[18px] solo-claro" />
  <Icono nombre="sun-line" clase="size-[18px] solo-oscuro" />
</button>

<script>
  // Deben coincidir con --color-fondo de global.css, en cada tema.
  const FONDO = { claro: '#f0f1f3', oscuro: '#0d1a17' };
  const raiz = document.documentElement;

  function pintar(oscuro: boolean) {
    raiz.classList.toggle('dark', oscuro);
    document
      .getElementById('color-tema')
      ?.setAttribute('content', oscuro ? FONDO.oscuro : FONDO.claro);
    document.getElementById('alternar-tema')?.setAttribute('aria-pressed', String(oscuro));
  }

  // Al navegar, el botón es un elemento nuevo y se queda sin escucha, así que
  // hay que volver a engancharlo. astro:page-load se dispara en la primera
  // carga y después de cada cambio de página.
  function montar() {
    const boton = document.getElementById('alternar-tema');
    if (!boton) return;

    pintar(raiz.classList.contains('dark'));

    boton.addEventListener('click', () => {
      const oscuro = !raiz.classList.contains('dark');
      localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro');
      pintar(oscuro);
    });
  }

  document.addEventListener('astro:page-load', montar);

  // Si nunca eligió a mano, seguimos al sistema aunque cambie en caliente.
  // Esto vive en window y se registra una sola vez para toda la sesión.
  if (!(window as any).__sistemaEnganchado) {
    (window as any).__sistemaEnganchado = true;
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('tema')) pintar(e.matches);
    });
  }
</script>
