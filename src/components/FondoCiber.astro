---
/**
 * Fondo animado — capas de patrón que se desvanecen entre sí.
 *
 * La versión anterior cortaba la rejilla en seco a los lados y se veía como
 * una caja. Aquí cada capa lleva su propia máscara radial, con el centro
 * corrido, así que ninguna tiene borde: se disuelven unas sobre otras y el
 * ojo no encuentra dónde terminan.
 *
 * Cuatro capas, de atrás hacia adelante:
 *   1. resplandores    manchas de color que derivan
 *   2. rejilla         perspectiva, la que da profundidad
 *   3. puntos          malla fina, rellena los huecos
 *   4. diagonales      rayado muy tenue, le quita lo plano
 *
 * Sólo se animan `transform` y `opacity`. Con movimiento reducido todo se
 * queda quieto pero visible.
 */
interface Props {
  clase?: string;
}
const { clase = '' } = Astro.props;
---

<div class:list={['fondo-ciber', clase]} aria-hidden="true">
  <div class="brillo brillo-a"></div>
  <div class="brillo brillo-b"></div>
  <div class="brillo brillo-c"></div>

  <div class="capa rejilla"></div>
  <div class="capa puntos"></div>
  <div class="capa diagonales"></div>
</div>

<style>
  .fondo-ciber {
    position: absolute;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }

  /* Todas las capas de patrón comparten el mismo truco: se dibujan más
     grandes que su contenedor y se recortan con una máscara suave, de modo
     que el patrón nunca llega a un borde recto. */
  .capa {
    position: absolute;
    inset: -60% -30%;
  }

  /* ------------------------------------------------------- 2 · REJILLA */
  .rejilla {
    background-image:
      linear-gradient(to right, var(--color-borde) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-borde) 1px, transparent 1px);
    background-size: 58px 58px;
    transform: perspective(560px) rotateX(60deg) translateY(0);
    transform-origin: top center;
    opacity: 0.55;
    animation: correr 16s linear infinite;
    will-change: transform;

    -webkit-mask-image: radial-gradient(
      ellipse 70% 55% at 50% 22%,
      #000 0%,
      rgb(0 0 0 / 0.55) 45%,
      transparent 78%
    );
    mask-image: radial-gradient(
      ellipse 70% 55% at 50% 22%,
      #000 0%,
      rgb(0 0 0 / 0.55) 45%,
      transparent 78%
    );
  }
  @keyframes correr {
    to { transform: perspective(560px) rotateX(60deg) translateY(-58px); }
  }

  /* -------------------------------------------------------- 3 · PUNTOS */
  .puntos {
    background-image: radial-gradient(var(--color-borde-fuerte) 1px, transparent 1px);
    background-size: 26px 26px;
    opacity: 0.5;
    animation: flotar 22s ease-in-out infinite alternate;

    -webkit-mask-image: radial-gradient(
      ellipse 55% 45% at 78% 18%,
      #000 0%,
      transparent 70%
    );
    mask-image: radial-gradient(ellipse 55% 45% at 78% 18%, #000 0%, transparent 70%);
  }
  @keyframes flotar {
    to { transform: translate(-26px, 13px); }
  }

  /* ---------------------------------------------------- 4 · DIAGONALES */
  .diagonales {
    background-image: repeating-linear-gradient(
      -45deg,
      var(--color-borde) 0 1px,
      transparent 1px 13px
    );
    opacity: 0.35;

    -webkit-mask-image: radial-gradient(
      ellipse 50% 40% at 14% 32%,
      #000 0%,
      transparent 72%
    );
    mask-image: radial-gradient(ellipse 50% 40% at 14% 32%, #000 0%, transparent 72%);
  }

  /* --------------------------------------------------- 1 · RESPLANDORES */
  .brillo {
    position: absolute;
    border-radius: 9999px;
    filter: blur(100px);
    will-change: transform;
  }
  .brillo-a {
    top: -22%;
    left: -10%;
    width: 44rem;
    height: 44rem;
    background: radial-gradient(circle, var(--color-acento) 0%, transparent 70%);
    opacity: 0.1;
    animation: derivar-a 24s ease-in-out infinite alternate;
  }
  .brillo-b {
    top: -28%;
    right: -12%;
    width: 36rem;
    height: 36rem;
    background: radial-gradient(circle, var(--color-acento-brillante) 0%, transparent 70%);
    opacity: 0.08;
    animation: derivar-b 30s ease-in-out infinite alternate;
  }
  .brillo-c {
    top: 15%;
    left: 38%;
    width: 30rem;
    height: 30rem;
    background: radial-gradient(circle, var(--color-acento) 0%, transparent 72%);
    opacity: 0.06;
    animation: derivar-c 27s ease-in-out infinite alternate;
  }
  @keyframes derivar-a { to { transform: translate(7rem, 4rem) scale(1.18); } }
  @keyframes derivar-b { to { transform: translate(-6rem, 5rem) scale(0.88); } }
  @keyframes derivar-c { to { transform: translate(-4rem, -3rem) scale(1.25); } }

  /* En oscuro hay más contraste contra el fondo: las capas pueden marcarse */
  :global(html.dark) .rejilla { opacity: 0.85; }
  :global(html.dark) .puntos { opacity: 0.75; }
  :global(html.dark) .diagonales { opacity: 0.5; }
  :global(html.dark) .brillo-a { opacity: 0.17; }
  :global(html.dark) .brillo-b { opacity: 0.14; }
  :global(html.dark) .brillo-c { opacity: 0.1; }

  @media (prefers-reduced-motion: reduce) {
    .rejilla,
    .puntos,
    .brillo {
      animation: none;
    }
  }
</style>
