---
/**
 * Icono — SVG en línea, de dos colecciones.
 *
 * En el ERP los iconos entran por CDN, y ahí está bien. Aquí no: la fuente
 * completa de Remix pesa más de 100 KB por 3,229 iconos, y este sitio usa unos
 * treinta. Este componente lee los sets en tiempo de compilación y pega en el
 * HTML sólo el icono que pediste. Cero peticiones, cero fuente, cero CDN.
 *
 *   <Icono nombre="sun-line" />          → Remix Icon (el de siempre)
 *   <Icono nombre="si:laravel" />        → Simple Icons (logos de marcas)
 *
 * Los nombres de Remix son los de remixicon.com sin el prefijo `ri-`.
 * Los de Simple Icons, los de simpleicons.org en minúsculas y sin espacios.
 *
 * Un icono sin `titulo` es decorativo y se le esconde al lector de pantalla.
 * Si el icono ES la información (un botón sin texto), pásale `titulo`.
 */
import remix from '@iconify-json/ri/icons.json';
import marcas from '@iconify-json/simple-icons/icons.json';

interface Props {
  nombre: string;
  clase?: string;
  titulo?: string;
}

const { nombre, clase = 'size-5', titulo } = Astro.props;

type Set = {
  icons: Record<string, { body: string; width?: number; height?: number }>;
  aliases?: Record<string, { parent: string }>;
  width: number;
  height: number;
};

const esMarca = nombre.startsWith('si:');
const set = (esMarca ? marcas : remix) as unknown as Set;
const clave = nombre.replace(/^(si:|ri[:-])/, '');

const alias = set.aliases?.[clave]?.parent;
const icono = set.icons[clave] ?? (alias ? set.icons[alias] : undefined);

if (!icono) {
  const donde = esMarca
    ? 'https://simpleicons.org (en minúsculas, sin espacios, con el prefijo si:)'
    : 'https://remixicon.com (sin el prefijo ri-)';
  throw new Error(`Icono desconocido: "${nombre}". Busca el nombre exacto en ${donde}.`);
}

const ancho = icono.width ?? set.width;
const alto = icono.height ?? set.height;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${ancho} ${alto}`}
  class={clase}
  fill="currentColor"
  role={titulo ? 'img' : undefined}
  aria-hidden={titulo ? undefined : 'true'}
  focusable="false"
>
  {titulo && <title>{titulo}</title>}
  <Fragment set:html={icono.body} />
</svg>
