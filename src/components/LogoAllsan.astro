<g transform="translate(128,65.86)"><path d="M14.34 0.77Q8.7 0.77 5.41 -1.92Q2.11 -4.61 2.11 -9.34Q2.11 -13.76 5.18 -16.64Q8.26 -19.52 14.53 -20.54L24.19 -22.08V-23.04Q24.19 -25.02 22.62 -26.37Q21.06 -27.71 18.37 -27.71Q15.81 -27.71 13.86 -26.3Q11.9 -24.9 11.01 -22.59L3.33 -26.24Q4.86 -30.59 9.06 -33.15Q13.25 -35.71 18.82 -35.71Q23.23 -35.71 26.62 -34.11Q30.02 -32.51 31.9 -29.66Q33.79 -26.82 33.79 -23.04V0H24.83V-3.26Q20.86 0.77 14.34 0.77ZM12.03 -9.66Q12.03 -8.06 13.25 -7.17Q14.46 -6.27 16.26 -6.27Q19.84 -6.27 22.02 -8.51Q24.19 -10.75 24.19 -13.95V-15.04L16.26 -13.63Q14.21 -13.25 13.12 -12.32Q12.03 -11.39 12.03 -9.66Z M39.87 0V-48.45H49.47V0Z M55.55 0V-48.45H65.15V0Z" fill="var(--color-tinta)"/><path d="M84.93 0.77Q79.17 0.77 74.91 -1.95Q70.66 -4.67 69.12 -9.28L76.16 -12.61Q77.5 -9.79 79.81 -8.19Q82.11 -6.59 84.93 -6.59Q89.15 -6.59 89.15 -9.73Q89.15 -11.84 85.7 -12.8L79.74 -14.46Q75.46 -15.68 73.15 -18.4Q70.85 -21.12 70.85 -24.83Q70.85 -28.1 72.51 -30.53Q74.18 -32.96 77.18 -34.34Q80.19 -35.71 84.1 -35.71Q89.22 -35.71 93.09 -33.31Q96.96 -30.91 98.56 -26.56L91.46 -23.23Q90.69 -25.41 88.67 -26.72Q86.66 -28.03 84.1 -28.03Q82.24 -28.03 81.18 -27.26Q80.13 -26.5 80.13 -25.15Q80.13 -23.1 83.9 -22.02L89.47 -20.35Q93.82 -19.07 96.13 -16.48Q98.43 -13.89 98.43 -10.11Q98.43 -5.25 94.72 -2.24Q91.01 0.77 84.93 0.77Z M114.05 0.77Q108.42 0.77 105.12 -1.92Q101.82 -4.61 101.82 -9.34Q101.82 -13.76 104.9 -16.64Q107.97 -19.52 114.24 -20.54L123.9 -22.08V-23.04Q123.9 -25.02 122.34 -26.37Q120.77 -27.71 118.08 -27.71Q115.52 -27.71 113.57 -26.3Q111.62 -24.9 110.72 -22.59L103.04 -26.24Q104.58 -30.59 108.77 -33.15Q112.96 -35.71 118.53 -35.71Q122.94 -35.71 126.34 -34.11Q129.73 -32.51 131.62 -29.66Q133.5 -26.82 133.5 -23.04V0H124.54V-3.26Q120.58 0.77 114.05 0.77ZM111.74 -9.66Q111.74 -8.06 112.96 -7.17Q114.18 -6.27 115.97 -6.27Q119.55 -6.27 121.73 -8.51Q123.9 -10.75 123.9 -13.95V-15.04L115.97 -13.63Q113.92 -13.25 112.83 -12.32Q111.74 -11.39 111.74 -9.66Z M139.58 0V-34.94H148.54V-30.66Q149.89 -33.