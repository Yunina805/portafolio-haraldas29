---
/**
 * Logo de Allsan Sistemas.
 *
 * Un solo archivo para los dos temas: la palabra "all" usa var(--color-tinta)
 * y "san" usa var(--color-acento-brillante), así que el logo cambia con el
 * sitio sin mantener una versión clara y otra oscura.
 *
 * El cuadro del icono conserva su degradado de marca tal cual —es la parte
 * que no debe adaptarse a nada— y por eso funciona sobre cualquier fondo.
 *
 * Generado desde src/assets/marca/*.svg con la precisión de los trazos
 * recortada a dos decimales. Si el logo cambia, se vuelve a generar; no se
 * edita a mano.
 */
interface Props {
  /** Sólo el cuadro con la A, sin la palabra. Para espacios muy chicos. */
  soloIcono?: boolean;
  clase?: string;
  /** Texto para lectores de pantalla. Ponlo en null si al lado ya va el nombre. */
  titulo?: string | null;
}

const { soloIcono = false, clase = '', titulo = 'Allsan Sistemas' } = Astro.props;

// El degradado del icono vive en un <defs> con su id, y el logo sale dos veces
// por página (encabezado y pie). Dos elementos con el mismo id es HTML
// inválido, así que cada instancia numera el suyo.
const n = (globalThis.__allsanLogos = (globalThis.__allsanLogos ?? 0) + 1);
const gi = `allsan-gi-${n}`;
const gl = `allsan-gl-${n}`;
---

{
  soloIcono ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 512 512"
      class={clase}
      role={titulo ? 'img' : undefined}
      aria-hidden={titulo ? undefined : 'true'}
    >
      {titulo && <title>{titulo}</title>}
      <Fragment set:html={`<defs><linearGradient id="${gi}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#34d399"/><stop offset="1" stop-color="var(--color-acento-brillante)"/></linearGradient></defs>
<rect x="0" y="0" width="512" height="512" rx="128" fill="url(#${gi})"/><g fill="#ffffff" opacity="0.15"><circle cx="85.33" cy="85.33" r="6.93"/><circle cx="85.33" cy="170.67" r="6.93"/><circle cx="85.33" cy="256" r="6.93"/><circle cx="85.33" cy="341.33" r="6.93"/><circle cx="85.33" cy="426.67" r="6.93"/><circle cx="170.67" cy="85.33" r="6.93"/><circle cx="170.67" cy="170.67" r="6.93"/><circle cx="170.67" cy="256" r="6.93"/><circle cx="170.67" cy="341.33" r="6.93"/><circle cx="170.67" cy="426.67" r="6.93"/><circle cx="256" cy="85.33" r="6.93"/><circle cx="256" cy="170.67" r="6.93"/><circle cx="256" cy="256" r="6.93"/><circle cx="256" cy="341.33" r="6.93"/><circle cx="256" cy="426.67" r="6.93"/><circle cx="341.33" cy="85.33" r="6.93"/><circle cx="341.33" cy="170.67" r="6.93"/><circle cx="341.33" cy="256" r="6.93"/><circle cx="341.33" cy="341.33" r="6.93"/><circle cx="341.33" cy="426.67" r="6.93"/><circle cx="426.67" cy="85.33" r="6.93"/><circle cx="426.67" cy="170.67" r="6.93"/><circle cx="426.67" cy="256" r="6.93"/><circle cx="426.67" cy="341.33" r="6.93"/><circle cx="426.67" cy="426.67" r="6.93"/></g><path d="M128,389.33 L240,154.67 L352,389.33" stroke="#ffffff" stroke-width="42.67" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M171.2,298.67 L363.73,298.67" stroke="#ffffff" stroke-width="42.67" stroke-linecap="round" fill="none"/><circle cx="400" cy="298.67" r="26.67" fill="none" stroke="#ffffff" stroke-width="18.13"/>`} />
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 308 108"
      class={clase}
      role={titulo ? 'img' : undefined}
      aria-hidden={titulo ? undefined : 'true'}
    >
      {titulo && <title>{titulo}</title>}
