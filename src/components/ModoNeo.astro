---
/**
 * NEO OAXACA — el modo secreto.
 *
 * Vive sólo en /sobre-mi. Se enciende cuando el gatillo (código Konami o cinco
 * toques al logo) deja la marca en sessionStorage y trae al visitante aquí.
 *
 * Cambia la paleta entera del sitio, llena la pantalla de destellos, y saca
 * las ilustraciones que haya en `src/assets/sello/`. Nada de esto corre hasta
 * que se activa: apagado cuesta ~2 KB y cero trabajo de CPU.
 *
 * ── PARA CAMBIARLE EL NOMBRE ────────────────────────────────────────────
 * Una línea: la constante NOMBRE de aquí abajo.
 * ────────────────────────────────────────────────────────────────────────
 *
 * ── PARA AGREGAR ILUSTRACIONES ──────────────────────────────────────────
 * Arrastra PNG o WebP con fondo transparente a `src/assets/sello/`.
 * Aparecen solas, sin tocar código. Vertical se ve mejor (600 × 900).
 * ────────────────────────────────────────────────────────────────────────
 */
import { Image } from 'astro:assets';

const NOMBRE = 'NEO OAXACA';

// Astro las encuentra al compilar. El `**` incluye subcarpetas, así que da
// igual cómo estén organizadas dentro de sello/. Si no hay ninguna, el modo
// funciona igual — sólo sin ilustraciones.
const archivos = import.meta.glob<ImageMetadata>(
  '../assets/sello/**/*.{png,webp,jpg,jpeg,avif}',
  { eager: true, import: 'default' }
);
const ilustraciones = Object.values(archivos).sort((a, b) =>
  a.src.localeCompare(b.src)
);

// Los destellos de ambiente se dibujan de una vez, con posiciones y colores
// repartidos. Van en el HTML para que no los tenga que crear el navegador.
const TONOS = ['#ff6ec7', '#c084fc', '#00ffd5', '#ffd166', '#7dd3fc', '#ff2e88'];
const chispas = Array.from({ length: 22 }, (_, i) => ({
  izq: (i * 37 + 11) % 100,
  arriba: (i * 53 + 7) % 100,
  tam: 3 + (i % 4) * 2,
  tono: TONOS[i % TONOS.length],
  demora: (i % 11) * 0.55,
  duracion: 7 + (i % 6),
}));
---

<div id="neo" hidden>
  {/* Aura de fondo */}
  <div class="aura aura-a" aria-hidden="true"></div>
  <div class="aura aura-b" aria-hidden="true"></div>
  <div class="aura aura-c" aria-hidden="true"></div>

  {/* Destellos flotando */}
  <div class="chispas" aria-hidden="true">
    {
      chispas.map((c) => (
        <span
          style={`left:${c.izq}%;top:${c.arriba}%;width:${c.tam}px;height:${c.tam}px;
                  background:${c.tono};box-shadow:0 0 ${c.tam * 3}px ${c.tono};
                  animation-delay:${c.demora}s;animation-duration:${c.duracion}s`}
        />
      ))
    }
  </div>

  {/* Las ilustraciones */}
  {
    ilustraciones.length > 0 && (
      <div id="neo-arte" aria-hidden="true">
        {ilustraciones.map((img, i) => (
          <Image
            src={img}
            alt=""
            widths={[420, 840]}
            sizes="(max-width: 640px) 45vw, 22rem"
            format="webp"
            quality={82}
            hidden={i !== 0}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )
  }

  {/* Panel de control */}
  <div class="hud" role="status">
    <span class="latido" aria-hidden="true"></span>
    <span class="nombre">{NOMBRE}</span>

    {
      ilustraciones.length > 1 && (
        <>
          <span class="sep" aria-hidden="true" />
          <button type="button" id="neo-otra" class="btn">
            otra ✦ <span id="neo-cuenta">1/{ilustraciones.length}</span>
          </button>
        </>
      )
    }

    <span class="sep" aria-hidden="true"></span>
    <button type="button" id="neo-salir" class="btn">salir · esc</button>
  </div>
</div>

<style>
  #neo {
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow: hidden;
    pointer-events: none;
  }
  #neo .btn {
    pointer-events: auto;
  }

  /* ---------------------------------------------------------- AURAS */
  .aura {
    position: absolute;
    border-radius: 9999px;
    filter: blur(110px);
    opacity: 0.4;
  }
  .aura-a {
    top: -20%;
    left: -10%;
    width: 46rem;
    height: 46rem;
    background: radial-gradient(circle, #ff2e88 0%, transparent 68%);
    animation: vagar-a 24s ease-in-out infinite alternate;
  }
  .aura-b {
    top: 25%;
    right: -14%;
    width: 40rem;
    height: 40rem;
    background: radial-gradient(circle, #a855f7 0%, transparent 68%);
    animation: vagar-b 30s ease-in-out infinite alternate;
  }
  .aura-c {
    bottom: -25%;
    left: 25%;
    width: 38rem;
    height: 38rem;
    background: radial-gradient(circle, #00ffd5 0%, transparent 68%);
    animation: vagar-c 27s ease-in-out infinite alternate;
  }
  @keyframes vagar-a { to { transform: translate(8rem, 5rem) scale(1.2); } }
  @keyframes vagar-b { to { transform: translate(-7rem, -4rem) scale(0.85); } }
  @keyframes vagar-c { to { transform: translate(5rem, -6rem) scale(1.1); } }

  /* ------------------------------------------------------- CHISPAS */
  .chispas span {
    position: absolute;
    border-radius: 9999px;
    animation-name: subir-chispa;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes subir-chispa {
    0%   { transform: translateY(0) scale(0.6); opacity: 0; }
    12%  { opacity: 1; }
    88%  { opacity: 1; }
    100% { transform: translateY(-70vh) scale(1.15); opacity: 0; }
  }

  /* ------------------------------------------------------ ARTE */
  #neo-arte img {
    position: absolute;
    right: 1rem;
    bottom: 0;
    width: min(20rem, 40vw);
    height: auto;
    pointer-events: auto;
    cursor: pointer;
    filter: drop-shadow(0 0 34px rgb(255 110 199 / 0.55));
    animation: llegar 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes llegar {
    from { opacity: 0; transform: translateY(2.5rem) scale(0.94); }
  }

  /* ----------------------------------------------------------- HUD */
  .hud {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 1rem;
    border: 1px solid #ff6ec7;
    border-radius: 9999px;
    background: rgb(20 6 33 / 0.88);
    backdrop-filter: blur(10px);
    box-shadow: 0 0 30px -6px #ff2e88;
    transform: translateX(-50%);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }
  .nombre {
    background: linear-gradient(90deg, #ff6ec7, #c084fc, #00ffd5);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .latido {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #00ffd5;
    box-shadow: 0 0 10px #00ffd5;
    animation: latir 1.3s ease-in-out infinite;
  }
  @keyframes latir { 50% { opacity: 0.2; } }
  .sep {
    width: 1px;
    height: 12px;
    background: rgb(255 110 199 / 0.35);
  }
  .btn {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    letter-spacing: 0.14em;
    color: #e9c9f5;
    cursor: pointer;
  }
  .btn:hover { color: #ff6ec7; }

  /* ============================================================
     LA PALETA — cambia el sitio entero mientras el modo está puesto
     ============================================================ */
  :global(html.neo) {
    --color-fondo: #0f0518;
    --color-superficie: #1c0d2e;
    --color-realce: #2d1548;
    --color-realce-fuerte: #3f1f63;

    --color-tinta: #fff0fb;
    --color-tinta-suave: #f3d9f7;
    --color-cuerpo: #dcc0e8;
    --color-apagado: #bb9bcd;
    --color-tenue: #a284b5;

    --color-borde: #3a1d5c;
    --color-borde-fuerte: #522b80;

    --color-acento: #ff6ec7;
    --color-acento-vivo: #ffa3e0;
    --color-acento-tinta: #1a0426;
    --color-acento-tenue: rgb(255 110 199 / 0.15);
    --color-acento-brillante: #ff2e88;

    --color-bien: #00ffd5;
    --color-bien-tenue: rgb(0 255 213 / 0.14);
    --color-mal: #ff4d6d;
    --color-aviso: #ffd166;

    --color-barra: #522b80;
    --color-foco: #00ffd5;
  }

  /* Los títulos toman el degradado */
  :global(html.neo) :global(h1),
  :global(html.neo) :global(h2) {
    background: linear-gradient(100deg, #ff6ec7 0%, #c084fc 45%, #00ffd5 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  :global(html.neo) :global(h1) :global(span),
  :global(html.neo) :global(h2) :global(span) {
    color: transparent;
  }

  /* Todos los iconos brillan */
  :global(html.neo) :global(svg) {
    filter: drop-shadow(0 0 6px currentColor);
  }

  /* Las tarjetas agarran borde de neón */
  :global(html.neo) :global(.contenedor) :global([class*='rounded-xl']),
  :global(html.neo) :global(.contenedor) :global([class*='rounded-2xl']) {
    box-shadow: 0 0 22px -10px #ff2e88;
  }

  /* El fondo cíber de la página se tiñe */
  :global(html.neo) :global(.rejilla) {
    opacity: 0.9 !important;
    animation-duration: 8s !important;
  }

  /* --------------------------------------------- MOVIMIENTO REDUCIDO */
  @media (prefers-reduced-motion: reduce) {
    .aura, .chispas span, .latido, #neo-arte img {
      animation: none;
    }
  }
</style>

<script>
  const TONOS = ['#ff6ec7', '#c084fc', '#00ffd5', '#ffd166', '#ff2e88'];

  function montar() {
    const capa = document.getElementById('neo');
    if (!capa) return;

    const raiz = document.documentElement;
    const arte = document.getElementById('neo-arte');
    const imgs = arte ? [...arte.querySelectorAll('img')] : [];
    const cuenta = document.getElementById('neo-cuenta');
    let actual = 0;
    let ultima = 0;

    const quietito = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* --- las ilustraciones ------------------------------------------ */
    function mostrar(i: number) {
      if (!imgs.length) return;
      actual = (i + imgs.length) % imgs.length;
      imgs.forEach((im, j) => (im.hidden = j !== actual));
      if (cuenta) cuenta.textContent = `${actual + 1}/${imgs.length}`;
    }

    document.getElementById('neo-otra')?.addEventListener('click', () => mostrar(actual + 1));
    arte?.addEventListener('click', () => mostrar(actual + 1));

    /* --- destellos que siguen al cursor ------------------------------ */
    function chispa(x: number, y: number, fuerza = 1) {
      const s = document.createElement('span');
      const t = TONOS[(Math.random() * TONOS.length) | 0];
      const tam = (3 + Math.random() * 5) * fuerza;
      const ang = Math.random() * Math.PI * 2;
      const dist = (18 + Math.random() * 46) * fuerza;

      s.style.cssText = `position:fixed;left:${x}px;top:${y}px;width:${tam}px;height:${tam}px;
        border-radius:9999px;background:${t};box-shadow:0 0 ${tam * 3}px ${t};
        pointer-events:none;z-index:85;translate:-50% -50%`;
      document.body.appendChild(s);

      s.animate(
        [
          { transform: 'scale(1)', opacity: 1 },
          {
            transform: `translate(${Math.cos(ang) * dist}px, ${Math.sin(ang) * dist + 24}px) scale(0)`,
            opacity: 0,
          },
        ],
        { duration: 620 + Math.random() * 420, easing: 'cubic-bezier(.22,1,.36,1)' }
      ).onfinish = () => s.remove();
    }

    function alMover(e: PointerEvent) {
      const ahora = performance.now();
      if (ahora - ultima < 45) return; // no una por cada píxel: mata la batería
      ultima = ahora;
      chispa(e.clientX, e.clientY, 0.7);
    }

    function alTocar(e: PointerEvent) {
      for (let i = 0; i < 14; i++) chispa(e.clientX, e.clientY, 1.5);
    }

    /* --- encender y apagar ------------------------------------------- */
    function encender() {
      raiz.classList.add('neo');
      capa!.hidden = false;
      mostrar(Math.floor(Math.random() * Math.max(imgs.length, 1)));
      if (!quietito) {
        window.addEventListener('pointermove', alMover, { passive: true });
        window.addEventListener('pointerdown', alTocar, { passive: true });
      }
    }

    function apagar() {
      raiz.classList.remove('neo');
      capa!.hidden = true;
      sessionStorage.removeItem('neo');
      window.removeEventListener('pointermove', alMover);
      window.removeEventListener('pointerdown', alTocar);
    }

    document.getElementById('neo-salir')?.addEventListener('click', apagar);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && raiz.classList.contains('neo')) apagar();
    });
    window.addEventListener('neo:encender', encender);

    // Si el gatillo dejó la marca antes de traerte aquí, se enciende solo.
    if (sessionStorage.getItem('neo') === '1') encender();
  }

  document.addEventListener('astro:page-load', montar);
  // Al salir de /sobre-mi el modo no se lleva a las demás páginas.
  document.addEventListener('astro:before-swap', () =>
    document.documentElement.classList.remove('neo')
  );
</script>
