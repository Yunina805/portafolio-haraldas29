---
/**
 * Tarjeta de proyecto para la rejilla.
 *
 * `destacada` la hace ancha y le da más aire: es lo que rompe la monotonía de
 * cinco tarjetas idénticas apiladas. La jerarquía la decide quién la usa, no
 * la posición en el arreglo.
 */
import Chip from './Chip.astro';
import Icono from './Icono.astro';

interface Proyecto {
  slug: string;
  nombre: string;
  titulo: string;
  gancho: string;
  periodo: string;
  estado: string;
  cifraTitular: { valor: string; etiqueta: string };
  resumen: string;
  stack: readonly { nombre: string; icono: string }[];
}

interface Props {
  proyecto: Proyecto;
  destacada?: boolean;
}

const { proyecto: p, destacada = false } = Astro.props;
const enProduccion = p.estado === 'En producción' || p.estado === 'En línea';
---

<a
  href={`/proyectos/${p.slug}`}
  class:list={[
    'group relative flex h-full flex-col rounded-2xl border border-borde bg-superficie',
    'shadow-sm transition-[transform,box-shadow,border-color] duration-200',
    'hover:-translate-y-1 hover:border-acento hover:shadow-lg',
    destacada ? 'p-8 sm:p-10' : 'p-7',
  ]}
>
  <div class="flex flex-wrap items-center gap-2">
    <Chip
      tono={enProduccion ? 'bien' : 'neutro'}
      icono={enProduccion ? 'checkbox-circle-line' : 'check-line'}
    >
      {p.estado}
    </Chip>
    <span class="text-xs text-tenue">{p.periodo}</span>
  </div>

  <p class="rotulo mt-6">{p.nombre}</p>

  <h3
    class:list={[
      'mt-3 font-extrabold tracking-tight text-tinta',
      destacada ? 'text-2xl sm:text-3xl' : 'text-xl',
    ]}
  >
    {p.titulo}
  </h3>

  <p
    class:list={[
      'mt-3 leading-relaxed text-apagado',
      destacada ? 'max-w-xl text-[15px]' : 'text-sm',
    ]}
  >
    {destacada ? p.resumen : p.gancho}
  </p>

  {/* Los logos son lo que le da textura a una tarjeta que si no es puro texto */}
  <ul class="mt-7 flex flex-wrap items-center gap-2.5">
    {
      p.stack.map((t) => (
        <li
          class="flex items-center gap-1.5 rounded-lg border border-borde bg-realce px-2.5 py-1.5"
          title={t.nombre}
        >
          <Icono nombre={t.icono} clase="size-3.5 shrink-0 text-apagado" />
          <span class="text-[11px] font-bold text-apagado">{t.nombre}</span>
        </li>
      ))
    }
  </ul>

  {/* Empuja el pie hacia abajo para que todas las tarjetas terminen parejas */}
  <div class="grow"></div>

  <div class="mt-8 flex items-end justify-between gap-4 border-t border-borde pt-6">
    <div>
      <p
        class:list={[
          'font-extrabold tracking-tight text-tinta',
          destacada ? 'text-3xl' : 'text-2xl',
        ]}
      >
        {p.cifraTitular.valor}
      </p>
      <p class="mt-1 text-xs text-tenue">{p.cifraTitular.etiqueta}</p>
    </div>

    <span class="flex items-center gap-1.5 text-sm font-bold text-acento">
      Ver detalle
      <Icono
        nombre="arrow-right-line"
        clase="size-4 transition-transform duration-200 group-hover:translate-x-1"
      />
    </span>
  </div>
</a>
