---
/**
 * Tarjeta de proyecto — la misma en la portada y en /proyectos.
 *
 * Todos los repositorios son privados: son sistemas en operación con datos de
 * clientes reales. En vez de esconder eso, se dice de frente — que un sistema
 * esté cerrado porque tiene datos de gente adentro habla bien, no mal.
 */
import Tarjeta from './Tarjeta.astro';
import Chip from './Chip.astro';
import Boton from './Boton.astro';
import Icono from './Icono.astro';

interface Proyecto {
  nombre: string;
  titulo: string;
  papel: string;
  resumen: string;
  periodo: string;
  estado: string;
  stack: readonly string[];
  cifras: readonly { valor: string; etiqueta: string }[];
  destacados: readonly string[];
  enlaceVivo: string | null;
}

interface Props {
  proyecto: Proyecto;
  /** Recorta los puntos destacados. Se usa en la portada, donde sobra detalle. */
  compacto?: boolean;
}

const { proyecto: p, compacto = false } = Astro.props;

const destacados = compacto ? p.destacados.slice(0, 3) : p.destacados;
const enProduccion = p.estado === 'En producción' || p.estado === 'En línea';
---

<Tarjeta relleno="lg">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    {/* Columna de datos */}
    <div class="lg:col-span-4">
      <div class="flex flex-wrap items-center gap-2">
        <Chip
          tono={enProduccion ? 'bien' : 'neutro'}
          icono={enProduccion ? 'checkbox-circle-line' : 'check-line'}
        >
          {p.estado}
        </Chip>
        <span class="text-xs text-tenue">{p.periodo}</span>
      </div>

      {
        p.cifras.length > 0 && (
          <dl class="mt-8 grid grid-cols-2 gap-x-4 gap-y-6">
            {p.cifras.map((c) => (
              <div>
                <dt class="text-2xl font-extrabold tracking-tight text-tinta">{c.valor}</dt>
                <dd class="mt-1 text-xs text-tenue">{c.etiqueta}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <div class="mt-8 flex flex-wrap gap-2">
        {p.stack.map((t) => <Chip>{t}</Chip>)}
      </div>

      <div class="mt-8 space-y-4">
        {
          p.enlaceVivo && (
            <Boton href={p.enlaceVivo} variante="contorno" icono="external-link-line" externo>
              Ver el sitio en vivo
            </Boton>
          )
        }
        <p class="flex items-start gap-2 text-xs leading-relaxed text-tenue">
          <Icono nombre="lock-line" clase="mt-0.5 size-3.5 shrink-0" />
          Código privado — es un sistema en operación con datos reales
        </p>
      </div>
    </div>

    {/* Columna narrativa */}
    <div class="lg:col-span-8">
      <p class="rotulo">{p.nombre}</p>
      <h3 class="mt-3 text-2xl font-extrabold tracking-tight text-tinta sm:text-3xl">
        {p.titulo}
      </h3>
      <p class="mt-2 text-sm font-semibold text-acento">{p.papel}</p>

      <p class="mt-6 text-[15px] leading-relaxed text-cuerpo">{p.resumen}</p>

      <ul class="mt-8 space-y-4">
        {
          destacados.map((d) => (
            <li class="flex gap-3">
              <Icono nombre="corner-down-right-line" clase="mt-0.5 size-4 shrink-0 text-acento" />
              <span class="text-[15px] leading-relaxed text-apagado">{d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Tarjeta>
