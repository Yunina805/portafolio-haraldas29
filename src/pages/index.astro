---
import Base from '../layouts/Base.astro';
import Seccion from '../components/Seccion.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Boton from '../components/Boton.astro';
import Chip from '../components/Chip.astro';
import Icono from '../components/Icono.astro';
import Rotulo from '../components/Rotulo.astro';
import Revelar from '../components/Revelar.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import {
  CIFRAS,
  COMPROMISOS,
  PROCESO,
  PROYECTOS,
  SERVICIOS,
  SITIO,
} from '../consts';

const wa = `https://wa.me/${SITIO.whatsapp}`;

// El de portada se marca en consts.ts, no se elige aquí por posición.
const destacado = PROYECTOS.find((p) => p.portada) ?? PROYECTOS[0];

/**
 * En cuántos sistemas uso cada tecnología.
 *
 * Sale de los proyectos, no de una lista escrita a mano: nadie se autocalifica
 * y cualquiera puede verificarlo entrando a /proyectos y contando. Dice algo
 * que un porcentaje no puede — qué uso todos los días y qué toqué una vez.
 *
 * "Laravel 12" y "Laravel" son lo mismo, así que se quita la versión del final.
 */
const familia = (n: string) => n.replace(/\s+\d+$/, '');

const conteo = new Map<string, { nombre: string; icono: string; n: number }>();
for (const proy of PROYECTOS) {
  const yaContadas = new Set<string>();
  for (const t of proy.stack) {
    const base = familia(t.nombre);
    if (yaContadas.has(base)) continue;
    yaContadas.add(base);
    const fila = conteo.get(base) ?? { nombre: base, icono: t.icono, n: 0 };
    fila.n += 1;
    conteo.set(base, fila);
  }
}

const barras = [...conteo.values()].sort(
  (a, b) => b.n - a.n || a.nombre.localeCompare(b.nombre)
);

/**
 * Los pasos agrupados por fase, conservando su número global (01–06).
 * El corte lo marcan los datos, no el diseño: si mañana entra un paso nuevo
 * antes de la firma, se acomoda en la banda que le toca.
 */
const numerados = PROCESO.map((paso, i) => ({ ...paso, n: i + 1 }));

const FASES = [
  {
    etiqueta: 'Antes de firmar',
    insignia: 'No te cuesta nada',
    detalle:
      'Si la especificación no te convence, ahí se queda y no me debes nada.',
    pasos: numerados.filter((p) => p.fase === 'antes'),
  },
  {
    etiqueta: 'Ya trabajando',
    insignia: null,
    detalle: null,
    pasos: numerados.filter((p) => p.fase === 'durante'),
  },
];

// Servicios de terceros distintos con los que hablan los sistemas.
const integraciones = [
  ...new Set(PROYECTOS.flatMap((p) => p.integraciones.map((i) => i.nombre))),
].sort((a, b) => a.localeCompare(b));
---

<Base titulo="">
  <!-- ======================================================== PORTADA -->
  {/* Todo el hero cabe en la primera pantalla, cifras incluidas: son la prueba
      que sostiene la confianza y no sirven si hay que hacer scroll para verlas.
      Por eso son tres grupos de animación y no seis — entran casi juntos. */}
  <section class="contenedor pt-9 pb-12 sm:pt-12 sm:pb-16 lg:pt-14">
    <Revelar>
      <Rotulo>{SITIO.oficio} · {SITIO.ciudadCorta}</Rotulo>

      <h1
        class="mt-5 max-w-4xl text-4xl leading-[1.05] font-extrabold tracking-tighter
               text-tinta sm:text-5xl lg:text-6xl"
      >
        Construyo el sistema que <span class="text-acento">tu negocio</span> necesita
      </h1>
    </Revelar>

    <Revelar retraso={90}>
      <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-cuerpo sm:text-lg">
        No vendo plantillas ni temas comprados. Entiendo cómo opera tu negocio y
        construyo exactamente lo que le hace falta — desde una tienda en línea
        hasta el ERP de un proveedor de internet.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <Boton href="/proyectos" tamano="lg" icono="arrow-right-line" iconoAlFinal>
          Ver proyectos
        </Boton>
        <Boton href="/contacto" tamano="lg" variante="contorno" icono="chat-1-line">
          Hablemos de tu proyecto
        </Boton>
      </div>

      {/* Los compromisos, arriba. Es lo que un cliente quiere saber antes de
          escribir, y casi ningún portafolio lo dice. */}
      <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-apagado">
        {
          Object.values(COMPROMISOS).map((c) => (
            <li class="flex items-center gap-2">
              <Icono nombre="check-line" clase="size-4 text-acento shrink-0" />
              {c}
            </li>
          ))
        }
      </ul>
    </Revelar>

    {/* Sin foto, las cifras verificables son lo que sostiene la confianza */}
    <Revelar retraso={180}>
      <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-borde pt-7 lg:grid-cols-4">
        {
          CIFRAS.map((c) => (
            <div>
              <dt class="text-2xl font-extrabold tracking-tight text-tinta sm:text-3xl">
                {c.valor}
                {c.unidad && <span class="ml-1.5 text-sm font-bold text-tenue">{c.unidad}</span>}
              </dt>
              <dd class="mt-1.5 text-sm text-apagado">{c.detalle}</dd>
            </div>
          ))
        }
      </dl>
    </Revelar>
  </section>

  {/* ===================================================== PROYECTOS
      Sólo el más grande. El resto vive en /proyectos, para que la portada
      no se convierta en un catálogo antes de haber convencido a nadie. */}
  <Seccion
    id="proyectos"
    rotulo="Proyectos"
    titulo="El sistema más grande que he construido"
    entrada="Un ERP completo para un proveedor de internet: en producción, creciendo, y sosteniendo la operación de la empresa todos los días."
  >
    <Revelar>
      <TarjetaProyecto proyecto={destacado} destacada />
    </Revelar>

    <Revelar retraso={80}>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <Boton href="/proyectos" tamano="lg" icono="arrow-right-line" iconoAlFinal>
          Ver los {PROYECTOS.length} proyectos
        </Boton>
        <p class="text-sm text-tenue">
          ERP de telefonía, portales de autoservicio, redes de distribuidores y más.
        </p>
      </div>
    </Revelar>
  </Seccion>

  {/* ====================================================== QUÉ CONSTRUYO
      Antes eran dos secciones —"Qué construyo" y "Herramientas"— que decían
      casi lo mismo. Ahora es una sola en tres capas: lo que le vendes al
      cliente, la prueba de que lo has hecho, y con qué habla lo que construiste. */}
  <Seccion
    id="servicios"
    rotulo="Qué construyo"
    titulo="Problemas que resuelvo, no tecnologías que uso"
    entrada="Nadie contrata Laravel. Se contrata que los cobros dejen de perderse, que el inventario cuadre, que el cliente pueda pagar en línea."
  >
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        SERVICIOS.map((s, i) => (
          <Revelar retraso={(i % 3) * 80}>
            <Tarjeta relleno="lg" clase="h-full">
              <span class="grid size-11 place-items-center rounded-xl bg-acento-tenue">
                <Icono nombre={s.icono} clase="size-5 text-acento" />
              </span>
              <h3 class="mt-6 text-lg font-bold tracking-tight text-tinta">{s.titulo}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-apagado">{s.detalle}</p>
            </Tarjeta>
          </Revelar>
        ))
      }
    </div>

    {/* ------------------------------------------- LA PRUEBA */}
    <div class="mt-16 grid gap-10 border-t border-borde pt-14 lg:grid-cols-2 lg:gap-16">
      <div>
        <Revelar>
          <h3 class="text-2xl font-extrabold tracking-tight text-tinta">Con qué lo construyo</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-apagado">
            En cuántos de mis cinco sistemas uso cada herramienta. No es una
            autoevaluación: sale de los proyectos, y cualquiera puede contarlo
            entrando a la página de proyectos.
          </p>
        </Revelar>

        <Revelar retraso={80}>
          <ul class="mt-8 space-y-4">
            {
              barras.map((t, i) => (
                <li class="flex items-center gap-4">
                  <Icono nombre={t.icono} clase="size-5 shrink-0 text-apagado" />
                  <span class="w-28 shrink-0 text-sm font-bold text-tinta">{t.nombre}</span>

                  <span
                    class="h-2 flex-1 overflow-hidden rounded-full bg-realce"
                    role="img"
                    aria-label={`${t.nombre}: ${t.n} de ${PROYECTOS.length} sistemas`}
                  >
                    <span
                      class="barra-relleno block h-full rounded-full bg-acento"
                      style={`width:${(t.n / PROYECTOS.length) * 100}%;transition-delay:${i * 60}ms`}
                    />
                  </span>

                  <span class="w-14 shrink-0 text-right text-xs font-bold text-tenue tabular-nums">
                    {t.n} de {PROYECTOS.length}
                  </span>
                </li>
              ))
            }
          </ul>
        </Revelar>

        <Revelar retraso={160}>
          <p class="mt-8 text-[15px] leading-relaxed text-apagado">
            Elijo la herramienta según lo que el proyecto necesita, no al revés.
            Este mismo sitio está hecho con Astro y no con Laravel, porque es
            una página de contenido y no una aplicación.
          </p>
        </Revelar>
      </div>

      {/* ------------------------------- MURO DE INTEGRACIONES */}
      <div>
        <Revelar>
          <h3 class="text-2xl font-extrabold tracking-tight text-tinta">
            Y con qué hablan mis sistemas
          </h3>
          <p class="mt-3 text-[15px] leading-relaxed text-apagado">
            Un sistema aislado sirve de poco. Estos son los
            <strong class="font-bold text-tinta">{integraciones.length} servicios</strong>
            de terceros que mis proyectos consumen hoy en producción: pasarelas
            de pago, facturación ante el SAT, validación de identidad y equipos
            de red.
          </p>
        </Revelar>

        <Revelar retraso={80}>
          <ul class="mt-8 flex flex-wrap gap-2.5">
            {
              integraciones.map((n) => (
                <li class="flex items-center gap-2 rounded-xl border border-borde bg-superficie px-3.5 py-2.5 shadow-sm">
                  <Icono nombre="plug-line" clase="size-4 shrink-0 text-acento" />
                  <span class="text-sm font-bold text-tinta">{n}</span>
                </li>
              ))
            }
          </ul>
        </Revelar>

        <Revelar retraso={160}>
          <Boton href="/proyectos" variante="contorno" icono="arrow-right-line" iconoAlFinal clase="mt-8">
            Ver en qué proyecto va cada una
          </Boton>
        </Revelar>
      </div>
    </div>
  </Seccion>

  {/* ======================================================== PROCESO
      Dos bandas de tres pasos. La división no es decorativa: arriba va todo
      lo que pasa ANTES de firmar y no le cuesta nada al cliente, abajo va el
      trabajo ya pagado. Ese corte era el argumento más fuerte de la sección
      y estaba enterrado dentro de los párrafos. */}
  <Seccion
    id="proceso"
    rotulo="Cómo trabajo"
    titulo="Sabes el alcance, el tiempo y el costo antes de firmar"
    entrada="Aprendí esto por experiencia: cuando el proyecto no está escrito desde el principio, crece a media obra y alguien termina perdiendo. Por eso todo queda en un documento antes de empezar."
  >
    <div class="space-y-12">
      {
        FASES.map((fase) => (
          <div>
            <Revelar>
              <div class="flex items-center gap-3">
                <p class="rotulo shrink-0">{fase.etiqueta}</p>
                {fase.insignia && (
                  <span class="shrink-0 rounded-lg bg-acento-tenue px-2.5 py-1 text-[11px] font-extrabold text-acento">
                    {fase.insignia}
                  </span>
                )}
                <span class="h-px flex-1 bg-borde" aria-hidden="true" />
              </div>

              {fase.detalle && (
                <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-apagado">
                  {fase.detalle}
                </p>
              )}
            </Revelar>

            <ol class="mt-6 grid gap-6 md:grid-cols-3">
              {fase.pasos.map((paso, i) => (
                <li class="relative">
                  {/* La flecha vive en el hueco entre tarjetas y sólo aparece
                      cuando están en fila; apiladas, el orden ya se entiende. */}
                  {i > 0 && (
                    <Icono
                      nombre="arrow-right-s-line"
                      clase="absolute top-1/2 -left-[1.375rem] hidden size-5 -translate-y-1/2 text-tenue md:block"
                    />
                  )}

                  <Revelar retraso={i * 80} clase="h-full">
                    <div class="flex h-full flex-col rounded-xl border border-borde bg-superficie p-6 shadow-sm">
                      <div class="flex items-start justify-between gap-4">
                        <span class="grid size-11 place-items-center rounded-xl bg-acento-tenue">
                          <Icono nombre={paso.icono} clase="size-5 text-acento" />
                        </span>
                        <span
                          class="text-2xl font-extrabold tracking-tight text-borde-fuerte tabular-nums"
                          aria-hidden="true"
                        >
                          {String(paso.n).padStart(2, '0')}
                        </span>
                      </div>

                      <h3 class="mt-5 text-base font-bold tracking-tight text-tinta">
                        {paso.titulo}
                      </h3>
                      <p class="mt-2.5 text-[15px] leading-relaxed text-apagado">{paso.detalle}</p>
                    </div>
                  </Revelar>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </Seccion>

  {/* ====================================================== CONTACTO
      Cierre de la portada. El detalle completo —vías, qué contarme, preguntas
      frecuentes— vive en /contacto para no alargar esta página. */}
  <Seccion id="contacto" aire="normal">
    <Revelar>
      <div
        class="overflow-hidden rounded-2xl border border-borde bg-superficie
               px-8 py-14 text-center shadow-sm sm:px-12 sm:py-16"
      >
        <Rotulo>Contacto</Rotulo>

        <h2
          class="mx-auto mt-4 max-w-2xl text-3xl font-extrabold tracking-tight
                 text-tinta sm:text-4xl"
        >
          Cuéntame qué necesitas y te digo si puedo resolverlo
        </h2>

        <p class="mx-auto mt-5 max-w-xl text-[15px] leading-relaxed text-apagado">
          {COMPROMISOS.respuesta}. Si el proyecto tiene sentido, te entrego la
          especificación completa con módulos, tiempo y costo — sin costo y sin
          compromiso.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <Boton href={wa} tamano="lg" icono="whatsapp-line" externo>
            Escríbeme por WhatsApp
          </Boton>
          <Boton href="/contacto" tamano="lg" variante="contorno" icono="customer-service-2-line">
            Ver todas las formas de contacto
          </Boton>
        </div>

        <ul
          class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3
                 border-t border-borde pt-8 text-sm text-tenue"
        >
          <li class="flex items-center gap-2">
            <Icono nombre="map-pin-line" clase="size-4 shrink-0" />
            {SITIO.ciudad}
          </li>
          <li class="flex items-center gap-2">
            <Icono nombre="global-line" clase="size-4 shrink-0" />
            {SITIO.cobertura}
          </li>
          <li class="flex items-center gap-2">
            <Icono nombre="vidicon-line" clase="size-4 shrink-0" />
            Sesiones por Zoom
          </li>
        </ul>
      </div>
    </Revelar>
  </Seccion>
</Base>
